{
  "manifest_version": 3,
  "name": "Meridian Downloader",
  "version": "1.0.0",
  "description": "Send video URLs to Meridian File Manager for download.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:7771/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
