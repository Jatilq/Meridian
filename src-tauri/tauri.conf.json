{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sigma File Manager",
  "version": "../package.json",
  "identifier": "com.sigma-file-manager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "E:\\ai\\apps\\pinokio\\bin\\miniconda\\pkgs\\nodejs-22.21.1-he453025_2\\npm.cmd run dev",
    "beforeBuildCommand": "E:\\ai\\apps\\pinokio\\bin\\miniconda\\pkgs\\nodejs-22.21.1-he453025_2\\npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sigma File Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 500,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#242227"
      },
      {
        "label": "quick-view",
        "title": "Sigma File Manager | Quick View",
        "width": 1280,
        "height": 720,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "url": "/quick-view"
      },
      {
        "label": "print-view",
        "title": "Sigma File Manager | Print",
        "width": 1280,
        "height": 720,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "url": "/print-view"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "binaries/yt-dlp.exe": "yt-dlp.exe"
    },
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}