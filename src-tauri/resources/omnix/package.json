{
  "name": "omnix",
  "version": "0.6.1",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "omnix": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx --expose-gc server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "start": "tsx --expose-gc server.ts",
    "engine": "tsx server.ts",
    "cli": "tsx src/cli/index.ts",
    "ui:dev": "vite",
    "desktop": "concurrently \"npm run engine\" \"wait-on tcp:9777 && electron .\"",
    "build:electron": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.omnix.studio",
    "productName": "Omnix Studio",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server.ts",
        "to": "server.ts"
      }
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@tailwindcss/vite": "^4.2.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "onnxruntime-node": "^1.20.0",
    "open": "^11.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "vite": "^8.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
